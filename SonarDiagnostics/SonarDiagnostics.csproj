<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <Import Project="..\SonarCommon.props" />

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>false</ImplicitUsings>
    <OutputPath>bin/</OutputPath>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="SonarDiagnostics.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- TC fork: zh-TW CheapLoc resource, see Plugin.SetupLocalization -->
    <EmbeddedResource Include="Resources\tc.cheaploc.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DryIoc.dll" Version="5.4.3" />
    <PackageReference Include="DryIoc.MefAttributedModel.dll" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonarUtils\SonarUtils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CheapLoc" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="1.2.39" />
  </ItemGroup>

</Project>
